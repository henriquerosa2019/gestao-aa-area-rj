# Configurações do Supabase para Deploy na Vercel e Desenvolvimento Local
# Substitua pelos dados do seu projeto em https://supabase.com/dashboard/project/_/settings/api

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# Bucket de Armazenamento de Arquivos no Supabase Storage
SUPABASE_STORAGE_BUCKET=documentos-delegado
